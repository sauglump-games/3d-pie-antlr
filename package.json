{
  "name": "3d-pie-antlr",
  "version": "0.0.1",
  "description": "A documented parser for the Warzone 2100 PIE 3D model format (versions 2, 3 and 4).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "pretest": "npm run antlr4ts",
    "test": "node --require ts-node/register --test test/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "antlr4ts": "antlr4ts -visitor ./g4/PIE4.g4 -o ./src/ && antlr4ts -visitor ./g4/PIE3.g4 -o ./src/ && antlr4ts -visitor ./g4/PIE2.g4 -o ./src/",
    "prepack": "npm run antlr4ts && npm run build",
    "demo:gltf": "node --require ts-node/register scripts/pie2gltf.ts test/fixtures/PIE3/cybd_run.pie cybd_run.gltf --fetch-texture",
    "demo:gltf:batch": "node --require ts-node/register scripts/pie2gltf-batch.ts test/fixtures gltf-out"
  },
  "keywords": [
    "warzone2100",
    "pie",
    "3d",
    "parser",
    "antlr"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.19.19",
    "antlr4ts-cli": "^0.5.0-alpha.4",
    "eslint": "^9.20.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.24.0"
  },
  "dependencies": {
    "antlr4ts": "^0.5.0-alpha.4"
  }
}
